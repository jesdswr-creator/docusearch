{
  "name": "docusearch",
  "version-string": "1.7.22",
  "description": "Offline Intelligent Document Search & OCR System for Windows",
  "dependencies": [
    {
      "name": "sqlite3",
      "features": ["fts5"]
    },
    "zlib"
  ],
  "features": {
    "tests": {
      "description": "Build unit tests (Qt Test framework)"
    },
    "semantic-search": {
      "description": "Enable BGE Small EN v1.5 semantic search via ONNX Runtime",
      "dependencies": [
        {
          "name": "onnxruntime",
          "default-features": false,
          "features": ["cpu"]
        }
      ]
    }
  }
}
