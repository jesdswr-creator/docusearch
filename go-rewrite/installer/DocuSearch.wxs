<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  DocuSearch.wxs — WiX v4 MSI installer for the Go + Wails build
  ============================================================

  This installer is intentionally minimal because Wails produces a
  single self-contained .exe (no DLLs, no Qt plugins, no themes).
  The installer just drops the .exe into Program Files and adds a
  Start Menu shortcut.

  Builds a 64-bit MSI that installs DocuSearch to:

      C:\Program Files\DocuSearch\

  Features:
    * Start Menu shortcut (DocuSearch)
    * Optional Desktop shortcut (controlled by INSTALLDESKTOPSHORTCUT)
    * Add/Remove Programs entry with publisher + version
    * Per-machine install (ALLUSERS=1) so all users on the PC get it
    * Uninstall removes the install dir but preserves user data at
      %APPDATA%\DocuSearch\ (database, logs)

  WiX v4 syntax notes (vs WiX v3):
    * Standard directories use <StandardDirectory Id="..."> instead of
      <Directory Id="TARGETDIR"><Directory Id="ProgramFiles64Folder">.
    * The Win64 attribute on <Component> was REMOVED — 64-bit is now
      the default when wix build is invoked with -platform x64.
    * <Condition> as a child of <Component> was REMOVED — use the
      Condition attribute on <Component> directly instead.

  Build with (WiX v4):

      wix build installer\DocuSearch.wxs `
          -o build\bin\DocuSearch-Setup.msi `
          -d ProductVersion=2.0.0.0 `
          -d BuildOutputDir=build\bin `
          -platform x64

  ============================================================
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?define ProductName       = "DocuSearch" ?>
  <?define ProductPublisher  = "DocuSearch" ?>
  <?ifndef ProductVersion ?>
  <?define ProductVersion    = "2.0.0.0" ?>
  <?endif ?>
  <!-- Stable UpgradeCode — NEVER change after the first release.
       Changing it would treat the new MSI as a different product and
       break upgrade detection. -->
  <?define ProductUpgradeCode = "B7E1F4A2-9C3D-4E8B-A1F6-5D2E7C9B0F31" ?>

  <Package
      Name="$(var.ProductName)"
      Manufacturer="$(var.ProductPublisher)"
      Version="$(var.ProductVersion)"
      Language="1033"
      Codepage="1252"
      UpgradeCode="$(var.ProductUpgradeCode)"
      InstallScope="perMachine">

    <SummaryInformation
        Codepage="1252"
        Description="$(var.ProductName) installer"
        Manufacturer="$(var.ProductPublisher)"
        Keywords="Installer,DocuSearch,Search,Document,OCR" />

    <!-- Major upgrade: uninstall the old version before installing the new one. -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <Media Id="1" Cabinet="DocuSearch.cab" EmbedCab="yes" />

    <!-- Installation properties.
         Note: ALLUSERS is set implicitly by InstallScope="perMachine" above.
         Do NOT add <Property Id="ALLUSERS"/> — WiX v4 will error with WIX0091. -->
    <Property Id="ARPNOREMOVE" Value="0" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jesdswr-creator/docusearch" />

    <!--
      UI: PoC builds ship without the WixUI install wizard (silent install).
      The WixToolset.UI.wixext extension was failing to resolve at build
      time in CI with WIX0144. The parity build can re-add:
        <UIRef Id="WixUI_InstallDir" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      and pass `-ext WixToolset.UI.wixext` to `wix build`.
    -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- =====================================================================
         Files
         ===================================================================== -->
    <Feature Id="Complete" Title="$(var.ProductName)" Level="1"
             Display="expand" Description="Complete installation">
      <Feature Id="MainProgram" Title="DocuSearch application" Level="1">
        <ComponentRef Id="MainExe" />
      </Feature>
      <Feature Id="Shortcuts" Title="Start menu shortcut" Level="1">
        <ComponentRef Id="StartMenuShortcut" />
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <!-- The single .exe produced by `wails build`. BuildOutputDir is
         passed via -d BuildOutputDir=build\bin so this file works in
         both local and CI builds. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
        <Component Id="MainExe" Guid="A4C2E1F0-3B5D-4A6E-9F1C-7D8B2E0A1C3F">
          <File Id="DocuSearchExe" Source="$(var.BuildOutputDir)\DocuSearch.exe"
                KeyPath="yes" Checksum="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="$(var.ProductName)">
        <Component Id="StartMenuShortcut" Guid="C5D3F2A1-4C6E-4B7F-A0D2-8E9F1A2B3C4D">
          <Shortcut Id="StartMenuShortcutLink"
                    Name="$(var.ProductName)"
                    Description="Offline Intelligent Document Search"
                    Target="[INSTALLFOLDER]DocuSearch.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveStartMenuDir" Directory="StartMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\$(var.ProductPublisher)\$(var.ProductName)"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Optional Desktop shortcut.
         WiX v4: use the Condition attribute on Component (not a child element). -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="D6E4A3B2-5D7F-4C80-B1E3-9F0A2B3C4D5E"
                 Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcutLink"
                  Name="$(var.ProductName)"
                  Description="Offline Intelligent Document Search"
                  Target="[INSTALLFOLDER]DocuSearch.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.ProductPublisher)\$(var.ProductName)"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>
